# RiriCloud 主控端生产配置模板（发行包）
# JWT_SECRET 必填：openssl rand -hex 32 生成强随机串
JWT_SECRET=

# 监听端口（默认 8080）
PORT=8080

# SQLite 数据库路径（相对 apps/server/prisma 目录；data/ 建议随版本升级保留）
DATABASE_URL=file:./data/riri.db

# 种子管理员（首次执行 node node_modules/prisma/build/index.js db seed 时使用）
SEED_ADMIN_EMAIL=admin@riricloud.local
SEED_ADMIN_PASSWORD=changeme-on-first-login
