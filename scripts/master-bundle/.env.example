# RiriCloud 主控端生产配置模板（发行包）
# JWT_SECRET 必填：openssl rand -hex 32 生成强随机串
JWT_SECRET=

# 监听端口（默认 8080）
PORT=8080

# 是否在启动时幂等创建演示数据（生产环境默认关闭）；Master-Local 始终自动创建
AUTO_SEED=false

# 是否启动发行包内置的本机 Agent（默认开启）
MASTER_AGENT_ENABLED=true

# 本机线路对外公布的主机名/IP；也可由 RIRICLOUD_PUBLIC_URL 自动推导
# MASTER_LOCAL_HOST=master.example.com

# SQLite 数据库路径（相对发行包 prisma/ 目录；data/ 建议随版本升级保留）
DATABASE_URL=file:./data/riri.db

# 首次启动空数据库时创建首个管理员；已有管理员不会被环境变量覆盖
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置，仅在对应 ADMIN_* 未填写时使用
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# AUTO_SEED=true 时才会创建演示用户、套餐、模板和示例线路；本机节点不受该开关影响
SEED_USER_EMAIL=demo@riricloud.local
SEED_USER_PASSWORD=riri-user-demo

# 节点下载/升级时使用的主控公网根地址（可选）
# RIRICLOUD_PUBLIC_URL=https://master.example.com
