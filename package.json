{
  "name": "riricloud",
  "version": "0.4.22",
  "private": true,
  "description": "RiriCloud — 多节点 VPN/代理管理系统（NestJS 主控 + React 面板 + Go 边缘 Agent）",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "setup": "pnpm install && pnpm --filter @riricloud/server exec prisma migrate dev && pnpm --filter @riricloud/server exec prisma db seed",
    "dev:server": "pnpm --filter @riricloud/server start:dev",
    "dev:web": "pnpm --filter @riricloud/web dev",
    "build": "pnpm --filter @riricloud/server build && pnpm --filter @riricloud/web build && bash scripts/build-agent.sh",
    "build:agent": "bash scripts/build-agent.sh",
    "build:agent:all": "bash scripts/build-agent.sh --all",
    "build:binaries": "bash scripts/build-binaries.sh",
    "bundle:master": "bash scripts/bundle-master.sh",
    "bump": "node scripts/version-governance.mjs bump",
    "bump:patch": "node scripts/version-governance.mjs bump patch",
    "bump:minor": "node scripts/version-governance.mjs bump minor",
    "bump:major": "node scripts/version-governance.mjs bump major",
    "gate:version": "node scripts/version-governance.mjs check",
    "gate:docs": "node scripts/doc-governance.mjs check",
    "gate:server": "pnpm --filter @riricloud/server exec tsc --noEmit && pnpm --filter @riricloud/server lint && pnpm --filter @riricloud/server test",
    "gate:web": "pnpm --filter @riricloud/web lint && pnpm --filter @riricloud/web build",
    "gate:agent": "bash scripts/gate-agent.sh",
    "gate": "pnpm gate:version && pnpm gate:docs && pnpm gate:server && pnpm gate:web && pnpm gate:agent",
    "plan:new": "node scripts/doc-governance.mjs new",
    "plan:archive": "node scripts/doc-governance.mjs archive",
    "plan:sync": "node scripts/doc-governance.mjs sync",
    "admin:reset": "bash scripts/admin-reset.sh",
    "docker:build": "bash scripts/docker-build.sh build",
    "docker:export": "bash scripts/docker-build.sh export",
    "docker:tags": "bash scripts/docker-build.sh tags",
    "docker:up": "bash scripts/docker-build.sh up",
    "docker:down": "bash scripts/docker-build.sh down"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "typescript-eslint": "^8.35.0"
  },
  "lint-staged": {
    "apps/server/**/*.ts": [
      "eslint --fix"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "apps/agent/**/*.go": [
      "gofmt -w"
    ]
  }
}
