# Docker Compose 本地/生产配置模板
# 复制为 .env 后填写 JWT_SECRET、ADMIN_EMAIL、ADMIN_PASSWORD。
JWT_SECRET=
AUTO_SEED=false
MASTER_PORT=3000
MASTER_AGENT_ENABLED=true

# 本机线路对外公布的主机名/IP；不填写时新库默认使用 127.0.0.1。
# 也可通过 RIRICLOUD_PUBLIC_URL 自动推导。
MASTER_LOCAL_HOST=
RIRICLOUD_PUBLIC_URL=

# 首次启动空数据库时创建首个管理员；已有管理员不会被环境变量覆盖。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置，仅在对应 ADMIN_* 未填写时使用。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 可选：远程 Agent 通过 Compose Agent profile 联调时填写；Master 本机 Agent 无需填写。
# AGENT_TOKEN=
# AGENT_MASTER_URL=ws://127.0.0.1:3000/ws/agent
# AGENT_MODE=ws
# POLL_INTERVAL_SECS=15
# SINGBOX_VERSION=1.14.0
# MASTER_IMAGE=riricloud/master:latest
# AGENT_IMAGE=riricloud/agent:latest
