# ZCode 会话产物(本地工作目录)
.zcode/

# 依赖与构建产物
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/
/artifacts/

# 环境变量（.env.example 除外）
.env
.env.*
!.env.example

# 本地数据库与运行数据
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# Go 构建产物
riri-agent
riri-agent.exe
*.exe~

# 本地开发缓存与便携工具链（缓存策略见 scripts/dev-env.sh）
.cache/
.tools/

# Docker 镜像导出包（本地生成，体积较大）
# 兼容旧版脚本或通过 DOCKER_EXPORT_DIR 指定的旧目录；默认输出已迁移至 artifacts/docker/。
docker-images/*.tar.gz
docker-images/*.sha256
docker-images/*.manifest.json

# husky 运行时目录
.husky/_

# 本地二进制托管目录
/binaries/
