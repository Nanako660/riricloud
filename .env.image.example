# RiriCloud 已导入镜像部署配置
# 使用 docker-compose.image.yml，并通过 --env-file .env.image 指定本文件。

# 导出包同时包含 latest 和版本号标签；生产环境建议固定到具体版本。
MASTER_IMAGE=riricloud/master:0.2.0
AGENT_IMAGE=riricloud/agent:0.2.0

MASTER_PORT=3000
MASTER_AGENT_ENABLED=true
MASTER_LOCAL_HOST=

# 可选：Master SQLite 数据目录与远程 Agent 运行数据目录；相对路径以 Compose 文件所在目录为基准。
# MASTER_DATA_PATH=./data
# AGENT_DATA_PATH=./data/agent

JWT_SECRET=
AUTO_SEED=false

# 首次启动空数据库时创建首个管理员，密码长度必须为 8-64 位。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置，仅在对应 ADMIN_* 未填写时使用。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 可选：远程 Agent 启用 Compose Agent profile 时填写；Master 本机 Agent 无需填写。
# AGENT_TOKEN=
# AGENT_MASTER_URL=ws://127.0.0.1:3000/ws/agent
# AGENT_MODE=ws
# POLL_INTERVAL_SECS=15
# RIRICLOUD_PUBLIC_URL=https://master.example.com
