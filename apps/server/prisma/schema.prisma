// RiriCloud 数据模型（设计见 docs/DATA_MODELS.md）
// SQLite 不支持 Prisma enum，角色/状态/协议均落地为 String + 应用层 class-validator 校验

generator client {
  provider      = "prisma-client-js"
  // native=发布/开发机（Windows），debian-openssl-3.0.x=主控端发行包目标机（Linux x64）
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              String    @default("USER") // Role 枚举：ADMIN | USER
  balance           Int       @default(0) // 账户余额，单位为分
  trafficLimitBytes BigInt    @default(107374182400) // 100 GiB
  trafficUsedBytes  BigInt    @default(0)
  expireAt          DateTime?
  subscriptionToken String    @unique @default(uuid())
  uuid              String    @unique @default(uuid()) // VLESS/Sing-box 用户识别
  password          String? // SS/Hysteria2 连接密码（预留）
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trafficLogs  TrafficLog[]
  subscription Subscription?
  balanceTransactions BalanceTransaction[]
  redeemedCodes RedeemCode[] @relation("RedeemedCodes")

  @@index([role])
  @@index([isActive])
}

model Node {
  id             String    @id @default(uuid())
  name           String
  serverHost     String
  isLocal        Boolean   @default(false) // 主控本机预置节点
  configOverride String? // 高级模式：完整 singboxConfig 顶层覆盖 JSON（与生成配置深合并）
  agentToken     String    @unique
  communicationMode String  @default("WS") // WS | HTTP
  pollIntervalSecs Int     @default(15) // HTTP 轮询建议周期，秒
  status         String    @default("OFFLINE") // ONLINE | OFFLINE | DISABLED
  lastSeenAt     DateTime?
  cpuUsage       Float?
  memoryUsage    Float?
  bandwidthRate  Float?
  uploadRate     Float?
  downloadRate   Float?
  kernelRunning  Boolean? // Agent 心跳上报的内核进程存活状态（旧版 Agent 不上报时保持 null）
  configError    String? // 最近一次配置应用失败原因（check 失败/回执失败），成功后清空
  lastProbeResult String? // 最近一次网络探针结果 JSON
  agentVersion   String? // Agent 编译版本
  agentProtocolVersion Int? // Agent 上报的 Master-Agent 协议版本
  osArch         String? // Agent 运行平台与架构，例如 linux/amd64
  kernelVersion  String? // sing-box 内核版本
  currentAgentAssetId   String?
  currentSingboxAssetId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // NodeInbound 为历史迁移兼容表，新线路配置不再依赖它。
  inbounds    NodeInbound[]
  entryLines  Line[]        @relation("LineEntryNode")
  exitLines   Line[]        @relation("LineExitNode")
  trafficLogs TrafficLog[]
  trafficCursors TrafficCursor[]
  rateMetrics NodeRateMetric[]
  binaryDeploymentTasks BinaryDeploymentTask[]

  @@index([status])
  @@index([isLocal])
}

model NodeRateMetric {
  id               String   @id @default(uuid())
  nodeId           String
  bucketStart      DateTime
  sampleCount      Int      @default(0)
  uploadRateSum    Float    @default(0)
  downloadRateSum  Float    @default(0)
  uploadRatePeak   Float    @default(0)
  downloadRatePeak Float    @default(0)

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, bucketStart])
  @@index([nodeId, bucketStart])
  @@index([bucketStart])
}

// Sing-box 累计流量游标：按节点与原始用户凭证保存上次已观察的总量。
model TrafficCursor {
  id           String   @id @default(uuid())
  nodeId       String
  credential   String
  uploadTotal  BigInt   @default(0)
  downloadTotal BigInt  @default(0)
  updatedAt    DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, credential])
  @@index([nodeId, updatedAt])
}

model Plan {
  id                String   @id @default(uuid())
  name              String
  description       String?
  price             Int      @default(0) // 价格最小货币单位
  durationDays      Int
  trafficLimitBytes BigInt
  lineMatchMode     String   @default("ALL") // ALL | TAGS | EXPLICIT
  lineTagsJson      String   @default("[]")
  lineIdsJson       String   @default("[]")
  templateId        String?
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  template      SubscriptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@index([isPublic])
  @@index([sortOrder])
}

// ==============================
// 2.3 接入线路实体 (Line，v0.4.0)
// Line 是唯一面向用户的代理业务端点，内聚协议、参数与入口/出口拓扑。
// ==============================
model Line {
  id              String   @id @default(uuid())
  name            String
  tag             String?
  listen          String   @default("0.0.0.0")
  type            String   @default("DIRECT") // DIRECT | RELAY
  relayMode       String? // BLIND_FORWARD | PROTOCOL_PROXY
  protocolType    String   @default("VLESS") // ProtocolType
  paramsJson      String   @default("{}") // 协议专属参数 JSON
  entryNodeId     String
  entryPort       Int
  exitNodeId      String
  exitPort        Int
  certificateId   String?
  endpointOverrideEnabled Boolean  @default(false)
  serverHost      String?
  serverPort      Int?
  serverName      String?
  host            String?
  trafficRate     Float    @default(1)
  tagsJson        String   @default("[]")
  level           Int      @default(0)
  sortOrder       Int      @default(0)
  isPublic        Boolean  @default(true)
  status          String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entryNode     Node @relation("LineEntryNode", fields: [entryNodeId], references: [id], onDelete: Cascade)
  exitNode      Node @relation("LineExitNode", fields: [exitNodeId], references: [id], onDelete: Cascade)
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  trafficLogs   TrafficLog[]

  @@index([entryNodeId])
  @@index([exitNodeId])
  @@index([certificateId])
  @@index([protocolType])
  @@index([type, status])
  @@index([isPublic])
  @@index([sortOrder])
}

model Certificate {
  id             String   @id @default(uuid())
  name           String
  certificatePem String
  privateKeyPem  String
  subject        String
  issuer         String
  serialNumber   String
  sansJson       String   @default("[]")
  validFrom      DateTime
  validTo        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines Line[]

  @@index([validTo])
}

model SubscriptionTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  isDefault        Boolean  @default(false)
  isBuiltin        Boolean  @default(false)
  proxyGroupsJson  String   @default("[]")
  ruleSetsJson     String   @default("[]")
  dnsConfigJson    String   @default("{}")
  customInjectYaml String?
  customInjectJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plans Plan[]

  @@index([isDefault])
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String    @unique
  planId            String
  status            String    @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED | REVOKED
  trafficLimitBytes BigInt
  trafficUsedBytes  BigInt    @default(0)
  startedAt         DateTime  @default(now())
  expireAt          DateTime?
  subscriptionToken String    @unique @default(uuid())
  canceledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([expireAt])
}

// 钱包余额流水，amount 为带符号的最小货币单位（分）。
model BalanceTransaction {
  id             String    @id @default(uuid())
  userId         String
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  type           String
  description    String?
  referenceId    String?
  redeemCodeId   String?   @unique
  createdAt      DateTime  @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemCode     RedeemCode? @relation(fields: [redeemCodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([referenceId])
}

// 管理员生成的充值卡密；code 始终以大写形式落库。
model RedeemCode {
  id                String    @id @default(uuid())
  code              String    @unique
  amount            Int
  status            String    @default("UNUSED") // UNUSED | REDEEMED | REVOKED
  expiresAt         DateTime?
  note              String?
  redeemedAt        DateTime?
  redeemedByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  redeemedBy        User?              @relation("RedeemedCodes", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  balanceTransaction BalanceTransaction?

  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([redeemedByUserId])
}

model NodeInbound {
  id         String   @id @default(uuid())
  nodeId     String
  type       String // ProtocolType 枚举：VLESS_REALITY | HYSTERIA2 | SHADOWSOCKS | TUIC
  tag        String // sing-box 入站 tag，节点内唯一
  listen     String   @default("0.0.0.0")
  port       Int
  paramsJson String   @default("{}") // 协议专属参数 JSON（结构见 docs/DATA_MODELS.md §3.1）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, tag])
  @@index([nodeId])
}

model TrafficLog {
  id         String   @id @default(uuid())
  nodeId     String
  userId     String
  lineId     String?
  upload     BigInt   @default(0) // 增量字节
  download   BigInt   @default(0)
  recordedAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  line Line? @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([userId])
  @@index([lineId])
  @@index([recordedAt])
  @@index([recordedAt, lineId])
  @@index([recordedAt, userId])
}

model SystemSetting {
  key         String   @id
  value       String // 站点名/默认配额/注册开关等 JSON 或文本
  description String?
  updatedAt   DateTime @updatedAt
}

// ==============================
// 4. 二进制资源中心
// BinaryRelease 是逻辑资源版本，BinaryAsset 是具体平台资产。
// ==============================
model BinaryRelease {
  id                  String   @id @default(uuid())
  kind                String   // AGENT | SINGBOX
  upstreamVersion     String
  revision            Int      @default(1)
  source              String   @default("BUILTIN") // BUILTIN | UPLOAD | REMOTE
  status              String   @default("DRAFT") // DRAFT | ACTIVE | DISABLED | RETIRED
  builtFromAppVersion String?
  compatibilityJson   String   @default("{}")
  notes               String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assets          BinaryAsset[]
  deploymentTasks BinaryDeploymentTask[]
  auditLogs       BinaryAuditLog[]

  @@unique([kind, upstreamVersion, revision])
  @@index([kind, status])
  @@index([isDefault])
}

model BinaryAsset {
  id          String   @id @default(uuid())
  releaseId   String
  target      String   // linux-amd64, windows-amd64 等
  os          String
  arch        String
  filename    String
  storageRoot String   @default("RUNTIME") // STATIC | RUNTIME
  storagePath String
  sha256      String
  size        Int
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  release             BinaryRelease          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  files               BinaryAssetFile[]
  deploymentTasks     BinaryDeploymentTask[] @relation("TargetBinaryAsset")
  previousDeployments BinaryDeploymentTask[] @relation("PreviousBinaryAsset")
  auditLogs           BinaryAuditLog[]

  @@unique([releaseId, target])
  @@index([target, available])
}

model BinaryAssetFile {
  id          String   @id @default(uuid())
  assetId     String
  name        String
  role        String   @default("main") // main | auxiliary
  storageRoot String   @default("RUNTIME")
  storagePath String
  sha256      String
  size        Int
  mode        Int      @default(493) // 0755
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset BinaryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, name])
  @@index([sha256])
}

model BinaryDeploymentTask {
  id              String   @id @default(uuid())
  nodeId          String
  assetId         String
  previousAssetId String?
  releaseId       String
  kind            String   // AGENT | SINGBOX
  operation       String   @default("UPGRADE") // UPGRADE | ROLLBACK
  status          String   @default("QUEUED") // QUEUED | DISPATCHED | COMPLETED | FAILED
  attempts        Int      @default(0)
  payloadJson     String   @default("{}")
  errorMessage    String?
  requestedById   String?
  requestedAt     DateTime @default(now())
  dispatchedAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  node          Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  asset         BinaryAsset  @relation("TargetBinaryAsset", fields: [assetId], references: [id], onDelete: Restrict)
  previousAsset BinaryAsset? @relation("PreviousBinaryAsset", fields: [previousAssetId], references: [id], onDelete: SetNull)
  release       BinaryRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  auditLogs BinaryAuditLog[]

  @@index([nodeId, status])
  @@index([assetId])
  @@index([releaseId])
  @@index([requestedAt])
}

model BinaryAuditLog {
  id           String   @id @default(uuid())
  action       String
  releaseId    String?
  assetId      String?
  taskId       String?
  nodeId       String?
  operatorId   String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  release BinaryRelease?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  asset   BinaryAsset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  task    BinaryDeploymentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([releaseId, createdAt])
  @@index([assetId, createdAt])
  @@index([taskId])
  @@index([nodeId, createdAt])
}
