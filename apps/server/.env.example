# 服务端口
PORT=3000

# SQLite 数据库文件（相对于 prisma/schema.prisma 所在目录）
DATABASE_URL=file:./dev.db

# JWT 签名密钥：生产环境必须显式提供强随机值；留空时开发模式自动生成进程内随机密钥
JWT_SECRET=

# 种子数据账号（pnpm --filter @riricloud/server exec prisma db seed）
# 密码仅用于本地演示，生产环境请自行修改
SEED_ADMIN_EMAIL=admin@riricloud.local
SEED_ADMIN_PASSWORD=riri-admin-demo
SEED_USER_EMAIL=demo@riricloud.local
SEED_USER_PASSWORD=riri-user-demo
