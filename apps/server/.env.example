# 服务端口
PORT=3000

# SQLite 数据库文件（相对于 prisma/schema.prisma 所在目录）
DATABASE_URL=file:./dev.db

# JWT 签名密钥：必须显式提供至少 32 位随机值
JWT_SECRET=

# 启动时是否创建完整演示数据；生产环境必须为 false（内嵌默认模板由 bootstrap 始终创建）
AUTO_SEED=false

# Master-Local 节点首次创建时使用的对外主机名/IP；已有节点不会被覆盖
# MASTER_LOCAL_HOST=master.example.com

# 首次启动空数据库时创建首个管理员；pnpm setup 执行 seed 时可留空以使用本地演示默认值
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 兼容旧配置
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=demo@riricloud.local
SEED_USER_PASSWORD=RiriCloud-User-2026!
